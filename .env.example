# ============================================================
# S&P 500 Stocks Pipeline Environment Configuration
# ============================================================

# Project Name
COMPOSE_PROJECT_NAME=sp500-pipeline

# Docker Network
NETWORK_NAME=stock-pipeline-net

# Host Ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8082
POSTGRES_PORT=5432
AIRFLOW_PORT=8080

# MinIO Credentials & Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=stock-data
MINIO_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Kafka Configuration (KRaft Mode)
KAFKA_TOPIC=stock-market-data
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Producer Configuration
PRODUCER_RATE=100
PRODUCER_MAX_RECORDS=5000
PRODUCER_BATCH_SIZE=50
REPLAY_START_TIME=2000-01-01T00:00:00
REPLAY_INTERVAL_SECONDS=1
PRODUCER_DATA_PATH=/data/sp500_stocks.csv

# Spark Runtime Configuration
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
WINDOW_DURATION=5 minutes
WATERMARK_DURATION=10 minutes

# PostgreSQL Database Configuration
POSTGRES_DB=stock_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT_INTERNAL=5432

# Airflow Configuration
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/stock_analytics
